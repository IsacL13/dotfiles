{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "font_family": "Terminess Nerd Font",
  "font_size": 13.0,
  "theme": {
    "palette": "Base16",
    "name": "GruvboxDarkMedium",
    "accent": "Base0A"
  },
  "height": 30,
  "transparency_alpha": 230,
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": true
        },
        "layout": {
          "enable": false
        },
        "focused_window": {
          "enable": true,
          "show_icon": false
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Memory": {
        "enable": true,
		"label_prefix": "Icon"
      }
    },
    {
      "Date": {
        "enable": true,
        "format": "DayDateMonthYear"
      }
    },
    {
      "Time": {
        "enable": true,
        "format": { "Custom": "%H:%M" }
      }
    },
    {
      "Battery": {
        "enable": true,
		"hide_on_full_charge": true
      }
    }
  ]
}
